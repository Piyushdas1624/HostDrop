# HostDrop Security Configuration (.env)
# Rename this file to .env or let HostDrop auto-generate it on first launch.

# Salted PBKDF2-HMAC-SHA256 hash of the master passphrase (600,000 iterations)
# If not set, a secure 16-character passphrase is auto-generated on startup.
# HOSTDROP_PASSWORD_HASH=pbkdf2_sha256$600000$<salt_hex>$<dk_hex>

# 256-bit server secret key used for signing stateless HMAC-SHA256 session tokens.
# Survives server reboots so users stay logged in.
# HOSTDROP_SECRET_KEY=9f8e7d6c5b4a3928172635445362718293a4b5c6d7e8f9011223344556677889

# Secret URL-safe bookmark access key for 1-click mobile auto-login.
# HOSTDROP_ACCESS_KEY=ts_live_your_secret_bookmark_key_here

# Safe reverse-proxy header evaluation (CF-Connecting-IP, X-Forwarded-For).
# When true, proxy headers are only trusted if the direct connection originates from localhost (127.0.0.1/::1).
TRUST_PROXY_HEADERS=true

# Security sandbox: set to true to allow authenticated remote administrators
# to browse all host drives (C:\, D:\, /) via reverse tunnels.
# Default is false (sandboxed to designated Inbox and Library folders).
ALLOW_FULL_DRIVE_REMOTE=false
